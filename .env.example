# ─────────────────────────────────────────────────────────────
# Resguardo — variables de entorno de ejemplo
# Copia este archivo como .env y completa los valores.
# ─────────────────────────────────────────────────────────────

# Base de datos (SQLite en desarrollo; cambiar a postgresql://... en producción)
DATABASE_URL="file:./dev.db"

# API de Anthropic (usada en la Etapa 5 — análisis con IA)
# Obtén tu clave en https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Modelo de IA. Se centraliza aquí para poder cambiarlo sin tocar el código.
# Debe ser un modelo con soporte de "structured outputs" (JSON garantizado):
# claude-sonnet-5, claude-opus-4-8, claude-haiku-4-5 o claude-fable-5.
ANTHROPIC_MODEL="claude-sonnet-5"

# Proveedor de pago activo. Por ahora "simulado"; luego "flow" o "webpay".
PAYMENT_PROVIDER="simulado"

# URL base de la app (para construir enlaces de retorno del checkout)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
